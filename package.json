{
  "name": "sodax-sdks",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build --filter=!./apps/node",
    "build:packages": "turbo run build:packages",
    "dev": "turbo run dev",
    "dev:demo": "turbo run dev --filter=./apps/demo",
    "mock-intake:demo": "pnpm --filter=./apps/demo mock-intake",
    "mock-sponsoring:stellar": "pnpm --filter=./apps/stellar-sponsor-example mock-sponsoring",
    "pretty": "turbo run pretty --filter=!./apps/node",
    "lint": "turbo run lint --filter=!./apps/node",
    "lint:packages": "turbo run lint:packages",
    "checkTs": "turbo run checkTs --filter=!./apps/node",
    "checkTs:packages": "turbo run checkTs:packages",
    "test": "pnpm test:release-scripts && pnpm test:ci-scripts && turbo run test --filter=!./apps/node",
    "test:release-scripts": "node --test scripts/config-version.test.mjs scripts/release.test.mjs scripts/check-doc-links.test.mjs scripts/check-docs-nav.test.mjs scripts/sync-docs-pages.test.mjs scripts/pack-local.test.mjs",
    "test:ci-scripts": "node --test scripts/ai-drift-scope.test.mjs scripts/ai-drift-report.test.mjs scripts/check-docs-drift.test.mjs scripts/check-tests-typechecked.test.mjs scripts/check-swap-tokens-oracle.test.mjs",
    "test:e2e": "turbo run test:e2e --filter=!./apps/node",
    "test:packages": "turbo run test:packages",
    "check:circular-deps": "turbo run check:circular-deps",
    "check:circular-deps:packages": "turbo run check:circular-deps:packages",
    "check-exports": "turbo run check-exports --filter=./packages/*",
    "check:ai": "turbo run check:ai",
    "check:ai-dev-files": "node scripts/check-ai-dev-files.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:docs-nav": "node scripts/check-docs-nav.mjs",
    "check:swap-tokens-oracle": "node scripts/check-swap-tokens-oracle.mjs",
    "check:docs-pages": "node scripts/sync-docs-pages.mjs --check",
    "docs:sync-pages": "node scripts/sync-docs-pages.mjs",
    "docs:dev": "cd docs && mint dev",
    "docs:validate": "cd docs && mint validate && mint broken-links",
    "check:knip": "turbo run check:knip",
    "release": "node scripts/release.mjs",
    "pack:local": "node scripts/pack-local.mjs",
    "clean": "turbo clean && rm -rf node_modules dist .turbo && rm -rf apps/*/node_modules apps/*/dist apps/*/.turbo && rm -rf packages/*/node_modules packages/*/dist packages/*/.turbo",
    "prepare": "husky",
    "check:sponsoring-contract": "node scripts/check-sponsoring-contract.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "turbo": "^2.4.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
