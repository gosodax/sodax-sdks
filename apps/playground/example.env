# Copy to .env (gitignored) and fill in what you need. Every value is optional.
# Never commit a real endpoint or key — these are placeholders only.

# The origin the embed snippet points at. Without it the snippet quotes whatever origin is serving
# the page, which is right for a local preview and wrong for an <iframe> a partner pastes.
# VITE_EMBED_ORIGIN=https://widget.sodax.com

# Per-request API key for the SODAX swaps API, sent as x-api-key. The public endpoint needs none;
# set one if a deployment gets enough traffic to warrant its own quota. Anything in a Vite bundle
# is public — never put a privileged key here.
# VITE_SWAPS_API_KEY=

# GTM container the events go to — the same one sodax.com loads. Unset, nothing loads and nothing
# is pushed, which is what local dev and CI run with.
# VITE_GTM_ID=GTM-W355PCS6

# Set to 1 to also load the container inside a partner's <iframe>. Off by default: on their page
# they own the consent decision.
# VITE_GTM_IN_EMBED=

# Optional EVM WalletConnect connector; register the deployed origin in WalletConnect.
# VITE_WALLETCONNECT_PROJECT_ID=

# Replaces the built-in Solana endpoint used for balance reads and for signing and broadcast. The
# built-in one works; set this to put a keyed provider, with its origin allowlisted, in its place.
# VITE_SOLANA_RPC_URL=

# Optional per-deployment partner fee. These are public configuration, never URL parameters.
# VITE_PARTNER_FEE_RECIPIENT=
# VITE_PARTNER_FEE_BPS=
