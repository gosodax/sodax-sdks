{
  "headers": [
    {
      "source": "/(.*)",

      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/__koios/:path*", "destination": "https://api.koios.rest/api/v1/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
