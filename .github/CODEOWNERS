# PRs can rewrite workflow YAML; owners must review .github CI changes.
/.github/workflows/ @gosodax/sodax-sdks-admin
/.github/scripts/ @gosodax/sodax-sdks-admin
/.github/CODEOWNERS @gosodax/sodax-sdks-admin

# Same reasoning as the docs gates below: these decide every published version and the
# CONFIG_VERSION that ships with it, and nothing in CI re-runs them against real history.
/scripts/release.mjs @gosodax/sodax-sdks-admin
/scripts/bump-versions.sh @gosodax/sodax-sdks-admin
/scripts/config-version.mjs @gosodax/sodax-sdks-admin
/scripts/publish-dist-tag.mjs @gosodax/sodax-sdks-admin

# The docs gates run from the PR head, so a PR can edit them to pass itself — including
# trimming the frozen must-not-break URL list, or the map Docs Drift reads.
/scripts/docs-pages-map.json @gosodax/sodax-sdks-admin
/scripts/check-doc-links.mjs @gosodax/sodax-sdks-admin
/scripts/check-docs-nav.mjs @gosodax/sodax-sdks-admin
/scripts/sync-docs-pages.mjs @gosodax/sodax-sdks-admin

# The published site. Root-anchored: bare `docs/` would also claim packages/*/docs/.
/docs/ @gosodax/sodax-sdks-admin

# Last, so they hold even if a docs root above ever grows to cover them: navigation and
# redirects decide every published URL, and the stylesheet and widget are the site's look.
/docs/docs.json @gosodax/sodax-sdks-admin
/docs/custom.css @gosodax/sodax-sdks-admin
/docs/stats-widget.js @gosodax/sodax-sdks-admin
/docs/.mintignore @gosodax/sodax-sdks-admin
