{
  "name": "@sodax/types",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "version": "2.3.0-rc.1",
  "description": "Sodax Common Types",
  "main": "dist/index.js",
  "homepage": "https://github.com/gosodax/sodax-sdks/tree/main/packages/types",
  "bugs": {
    "url": "https://github.com/gosodax/sodax-sdks/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gosodax/sodax-sdks"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dex": {
      "types": "./dist/dex/index.d.ts",
      "import": "./dist/dex/index.js",
      "default": "./dist/dex/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "dex": [
        "./dist/dex/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc && node ../../scripts/verify-dist-exports.mjs",
    "dev": "tsc --watch",
    "ci": "pnpm run pretty && pnpm run build && pnpm run test",
    "checkTs": "tsc && tsc -p tsconfig.check.json && node ../../scripts/check-tests-typechecked.mjs --project tsconfig.check.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "pretty": "biome format . --write",
    "lint": "biome lint . --write",
    "check-exports": "attw --pack --ignore-rules=cjs-resolves-to-esm",
    "check:circular-deps": "madge --circular $(find ./src -name '*.ts')",
    "check:knip": "knip",
    "clean": "rm -rf node_modules && rm -rf dist && rm -rf .turbo"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "knip": "catalog:",
    "madge": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "sodax",
    "types",
    "typescript",
    "multichain",
    "wallet-providers"
  ],
  "license": "MIT"
}
