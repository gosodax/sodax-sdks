{
  "schemas.BridgeableAmountResponseSchema": {
    "object": {
      "limit": {
        "object": {
          "amount": "string",
          "decimals": "number",
          "type": {
            "picklist": [
              "DEPOSIT_LIMIT",
              "WITHDRAWAL_LIMIT"
            ]
          }
        }
      }
    }
  },
  "schemas.BridgeableCheckResponseSchema": {
    "object": {
