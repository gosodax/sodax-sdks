    }
  },
  "schemas.BridgeSubmitTxResponseSchema": {
    "object": {
      "data": {
        "object": {
          "message": "string",
          "status": {
            "picklist": [
              "inserted",
              "duplicate"
            ]
          }
        }
      },
      "success": "boolean"
    }
  },
  "schemas.BridgeSubmitTxStatusResponseSchema": {
    "object": {
      "data": {
        "object": {
          "abandonedAt": {
            "optional": "string"
          },
          "failedAtStep": {
            "optional": "string"
          },
          "failureReason": {
            "optional": "string"
          },
          "processingAttempts": "number",
          "result": {
            "optional": {
              "object": {
                "dstIntentTxHash": "string",
                "packetData": {
                  "optional": {
                    "object": {
                      "conn_sn": "number",
                      "dst_address": "string",
                      "dst_chain_id": "number",
                      "dst_tx_hash": "string",
                      "payload": "string",
                      "signatures": {
                        "array": "string"
                      },
                      "src_address": "string",
                      "src_chain_id": "number",
                      "src_tx_hash": "string",
                      "status": {
                        "picklist": [
                          "pending",
                          "validating",
                          "executing",
                          "executed"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "srcChainKey": "string",
          "status": "string",
          "txHash": "string",
          "userMessage": {
            "optional": "string"
          }
        }
      },
      "success": "boolean"
    }
  },
